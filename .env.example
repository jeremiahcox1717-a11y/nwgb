# Password that unlocks the private site. Pick something only you know.
ACCESS_PASSWORD=change-me-to-a-long-secret

# Optional. If omitted, ACCESS_PASSWORD is used to sign the login cookie.
SESSION_SECRET=

# Google Cloud API key with these APIs enabled:
# - Places API (New)
# - Geocoding API
# Restrict the key to those APIs, and to your deployed domain if you host it.
GOOGLE_MAPS_API_KEY=
